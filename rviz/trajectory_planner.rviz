Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Track Map1
        - /Centerline1
        - /Speed Profile1
      Splitter Ratio: 0.55
    Tree Height: 520
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.82
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Track Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: ""
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Centerline
      Namespaces:
        track_centerline: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planned_centerline_marker
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Speed Profile
      Namespaces:
        optimal_trajectory: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planned_trajectory_marker
      Value: true
    - Alpha: 0.35
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 255; 255
      Enabled: false
      Head Diameter: 0.08
      Head Length: 0.06
      Length: 0.10
      Line Style: Lines
      Line Width: 0.02
      Name: Path Poses
      Offset: 0; 0; 0
      Pose Color: 255; 255; 255
      Pose Style: None
      Radius: 0.02
      Shaft Diameter: 0.02
      Shaft Length: 0.06
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planned_trajectory
      Value: false
  Enabled: true
  Global Options:
    Background Color: 28; 31; 36
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Scale: 85
      Target Frame: map
      X: 1.85
      Y: -1.70
    Saved: ~
Window Geometry:
  Height: 820
  Width: 1180
  X: 80
  Y: 60
